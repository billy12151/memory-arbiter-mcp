        </mxCell>
        <mxCell id="m6" value="逐条过第一道门（主题相似）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="520" as="sourcePoint" />
            <mxPoint x="970" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3" value="① 长度预筛：短的一方加倍仍达不到 0.8×长度和 → 直接跳过（省比对开销）；&#10;② 数字段归一后同系列（如「0.15.1 发版清单」对「0.15.2 发版清单」）→ 静默跳过；&#10;③ 主题相似度 ≥ 0.8 才算过门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="895" y="545" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="过门者再过第二道门（正文确认）：字符三元组余弦 ≥ 0.4；任一侧正文不足 40 字则跳过确认并标 low_confidence" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="670" as="sourcePoint" />
            <mxPoint x="270" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s4" value="排序规则（相似度降序 → 低置信靠后 → 正文余弦降序），&#10;最多保留 2 条提示；整个函数外层包 try/except：&#10;任何异常都静默返回空（报错不影响写入成功）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="195" y="700" width="150" height="70" as="geometry" />
        </mxCell>
