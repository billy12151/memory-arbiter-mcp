            <mxPoint x="270" y="800" as="sourcePoint" />
            <mxPoint x="95" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="写入响应（含相似提示，仅提示不改数据）" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
