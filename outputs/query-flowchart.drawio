          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="有候选留存" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n16" target="n17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" style="html=1;endArrow=block;" edge="1" parent="1" source="n17" target="n18">
