        <mxCell id="p2" value="写入流水线&#10;pipeline/write.py&#10;memory_write(290)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="50" width="140" height="40" as="geometry" />
