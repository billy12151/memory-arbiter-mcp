        <mxCell id="p3" value="提交后派发&#10;tools.py _post_commit&#10;_enqueue_content_postcommit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="50" width="140" height="40" as="geometry" />
