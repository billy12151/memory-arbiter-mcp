        <mxCell id="l5" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="90" as="sourcePoint" />
            <mxPoint x="730" y="1330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l6" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="90" as="sourcePoint" />
            <mxPoint x="890" y="1330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l7" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="90" as="sourcePoint" />
            <mxPoint x="1050" y="1330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="memory(action=&quot;remember&quot;, …)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="130" as="sourcePoint" />
            <mxPoint x="250" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="落盘成功 → 派发提交后任务 _post_commit(recheck_conflicts=True)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="180" as="sourcePoint" />
            <mxPoint x="410" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="入队证据索引（任务号 = semantic:{记忆号}@{版本号}）；队列上限 200" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="230" as="sourcePoint" />
            <mxPoint x="570" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s1" value="队列已满 → 返回 busy（写入响应只加 warning，不失败）；&#10;同一记忆来了新快照 → 旧任务标记被新快照合并（coalesced_by_newer_snapshot）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="255" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="等待索引结果（默认最多等 3000 毫秒，可配置为 0 即不等待）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="355" as="sourcePoint" />
            <mxPoint x="570" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="版本校验：若已不是最新版本 → 记为 stale_or_missing 并放弃" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="400" as="sourcePoint" />
            <mxPoint x="730" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="写入正文证据单元并生成向量（status = indexed 才继续）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="445" as="sourcePoint" />
            <mxPoint x="730" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="索引完成 → 入队语义冲突检查（after_evidence=True）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="570" y="490" as="sourcePoint" />
            <mxPoint x="890" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2" value="等待超时 → 写响应标 conflict_check.status = async&#10;（后端未就绪则标 deferred）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="515" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="写入响应返回（落盘已完成，冲突判定在后台继续）" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="610" as="sourcePoint" />
            <mxPoint x="90" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s3" value="前置校验（process_conflicts:112）：&#10;记忆须仍在 pending；须为 active；版本与正文哈希须一致；&#10;嵌入器与向量空间须正常 —— 任一不符直接给出明确原因并结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="640" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="同一记忆内部：证据单元两两配对筛查（含噪声噪音排除）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="765" as="sourcePoint" />
            <mxPoint x="730" y="765" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="内部发现先落库（保证跨记忆循环即使被截断，内部结论也不丢）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="810" as="sourcePoint" />
            <mxPoint x="730" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="跨记忆：每个证据单元取近邻 top5（同工作区、排除自身、只要正文类单元）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="855" as="sourcePoint" />
            <mxPoint x="730" y="855" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s4" value="确定性过滤链（不花模型算力）：&#10;局部判定忽略 → 排除跨版本演进域 → 双方来源元数据校验 → &#10;差异分类为“清晰” → 每个邻居只保留最近的一条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="880" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="确定性直连路径：同一键、值不同 → 直接判定，不调用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1000" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="其余候选：单向抽取式判定（预算不足或已达 10 对上限则停止）" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="1030" as="sourcePoint" />
            <mxPoint x="1050" y="1030" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="属性与取值（单方向）" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="1075" as="sourcePoint" />
            <mxPoint x="890" y="1075" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s6" value="判定失败分类：超时 / 后端不可用 / 后端报错 / 输出格式非法 / 未验证&#10;—— 分别记账，未验证的留给定期扫描兜底（fail-closed）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="1100" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="写入冲突提示：同一槽位（实体+属性+范围）已被应用中的变更占用则抑制" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="1200" as="sourcePoint" />
            <mxPoint x="730" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="落 semantic_evidence 提示：含成员版本、取值分组、左右证据片段、两侧正文哈希、模型信号" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="1245" as="sourcePoint" />
            <mxPoint x="730" y="1245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="结果汇总：有提示 → notices_created（若后续被截断则标 truncated）；无提示 → checked_no_notice；受预算限制未跑完 → incomplete" style="html=1;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="1295" as="sourcePoint" />
            <mxPoint x="730" y="1295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="说明：写入请求本身不等待完整判定。同步段只等到「证据已索引」，超时就先返回；真正的语义比对在后台单线程串行执行，结果以“提示（notice）”形式落库，供后续查询或人工复核。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="1180" width="440" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
