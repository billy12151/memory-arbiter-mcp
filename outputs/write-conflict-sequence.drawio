        <mxCell id="p4" value="证据索引线程&#10;EvidenceWorker&#10;(workers.py:24)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="本地库&#10;证据向量表 / 冲突表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="语义冲突线程&#10;SemanticWorker&#10;(workers.py:396)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="50" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="判定后端&#10;Qwen 小模型（本地）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="50" width="140" height="40" as="geometry" />
