  <diagram name="写入时冲突检测-时序图" id="wcon-seq">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="1420" math="0" shadow="0">
      <root>
