<mxfile host="app.diagrams.net" agent="mema-docs" version="24.7.8">
  <diagram name="冲突扫描-流程图" id="scan-flow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="mema 冲突扫描流程图（定期扫描 / 手动触发）" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="触发扫描&#10;（定时任务或工具调用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="参数夹取：最多 400 条记忆 / 45 秒预算 / 邻居 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="向量空间状态正常？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="直接报错：需要重建向量空间&#10;（不进入扫描）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="245" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="读扫描台账：决定全量还是增量；取抑制清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="350" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="取下一批活跃记忆（按 id 递增，增量从上次游标继续）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="430" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="该记忆可处理？&#10;（active / 未被取代 / 不在待办）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="跳过本条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="525" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="读证据单元与向量；缺失则现场补建索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="630" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="同一记忆内部：证据单元两两筛查&#10;（共用内部准入过滤，可判的先判）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="710" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="内部冲突 → 直接落冲突待办表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="712" width="240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="跨记忆：每个证据单元取向量近邻 top10+1（只计正文类，同桶）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="800" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="逐邻居走机器通道（确定性规则）：&#10;① 局部判定忽略 → 跳&#10;② 属于跨版本演进域 → 跳&#10;③ 仅正文类前 3 名参与机器可判路由&#10;④ 差异分类为「清晰」→ 记机器清除&#10;⑤ 命中抑制清单 → 跳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="890" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="仍有候选？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="落冲突待办表：&#10;同候选哈希去重 / 同槽位应用中的变更抑制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="1042" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="已达预算（时长/条数）或扫完？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="收尾：回收过期内部待办行；&#10;更新续扫游标；输出本轮统计&#10;（已处理 / 排队 / 机器清除 / 内部冲突）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="1160" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="继续处理下一条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="1178" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note" value="说明：扫描是写时判定的兜底与补全。写时漏掉或来不及判的，在这里按预算分轮次补齐；能机器确定的当场清除，不能确定的进待办队列，由后续人工或模型复核。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="880" width="420" height="80" as="geometry" />
