{
  "_readme": [
    "Copy to ~/.config/memory-arbiter/config.json and edit local paths.",
    "The embedding model enables local-text evidence recall.",
    "The Qwen model is optional and filters only check-route short pairs."
  ],
  "db_path": "~/.local/share/memory-arbiter/memory.sqlite3",
  "backup_jsonl": "~/.local/share/memory-arbiter/memory.backup.jsonl",
  "tool_profile": "product",
  "isolation": "none",
  "workspace_match_distance": 0.25,
  "vec": {
    "enabled": true,
    "dim": 768
  },
  "embedding": {
    "provider": "gguf",
    "model_path": "~/.node-llama-cpp/models/hf_ggml-org_embeddinggemma-300m-qat-Q8_0.gguf",
    "auto_query": true,
    "auto_write": true,
    "n_ctx": 2048,
    "reserved_tokens": 64,
    "max_unit_chars": 3600
  },
  "recall_pool_cap": 50,
  "content_like_cap": 30,
  "update_check": {
    "enabled": true
  },
  "semantic_conflict": {
    "enabled": false,
    "backend": "local_gguf",
    "model_path": "~/.local/share/memory-arbiter/models/semantic-conflict/Qwen2.5-0.5B-Instruct/qwen2.5-0.5b-instruct-q4_k_m.gguf",
    "on_write": "async",
    "queue_max_size": 100,
    "n_ctx": 1024,
    "n_threads": 4,
    "n_batch": 128,
    "resident": true,
    "preload": false,
    "job_timeout_ms": 5000,
    "inference_timeout_ms": 30000,
    "load_timeout_ms": 120000,
    "min_pair_budget_ms": 1000
  }
}
