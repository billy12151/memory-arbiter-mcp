# Since 0.15.0 configuration is file-only: every tunable lives in
# ~/.config/memory-arbiter/config.json (see examples/memory-arbiter.config.example.json).
# Environment variables are launch CONTEXT only — the six below. A config.json
# value takes precedence over the corresponding variable where both exist.

# Which config file to load (default: ~/.config/memory-arbiter/config.json).
# MEMORY_ARBITER_CONFIG=~/.config/memory-arbiter/config.json

# Local SQLite path. Defaults to ./memory_arbiter.sqlite3
# MEMORY_ARBITER_DB_PATH=./memory_arbiter.sqlite3

# Schema-1 append-only fallback when SQLite is unavailable or unwritable.
# MEMORY_ARBITER_BACKUP_JSONL=./memory_arbiter.backup.jsonl

# Server run mode: stdio (default) | streamable-http.
# MEMORY_ARBITER_MCP_TRANSPORT=streamable-http

# Caller identity (REQUIRED — no built-in defaults). The MCP server refuses to
# start when either value is blank. Under stdio this configured identity is the
# bridge for requests that carry no headers; under HTTP use the X-Mema-Client /
# X-Mema-Agent-Id headers instead.
# MEMORY_ARBITER_CLIENT=my-client
# MEMORY_ARBITER_AGENT_ID=my-agent

# Everything else (models, isolation, semantic conflict, HTTP bind) is
# configured in the JSON file. Stale exports of removed variables produce a
# "no longer read" warning in doctor/console/status.
