# Local SQLite path. Defaults to ./memory_arbiter.sqlite3
# Note: a value set in config.json takes precedence over this variable.
MEMORY_ARBITER_DB_PATH=./memory_arbiter.sqlite3

# Schema-1 append-only fallback when SQLite is unavailable or unwritable.
# The write fails if this path cannot be appended; legacy flat JSONL is not
# auto-converted by replay.
MEMORY_ARBITER_BACKUP_JSONL=./memory_arbiter.backup.jsonl

# Optional policy file for tool routing by client/agent.
MEMORY_ARBITER_POLICY=./examples/openclaw.agent-policy.json

# Durable user config. Prefer this for sqlite-vec, models, and update_check.
# Config values override corresponding environment fallbacks.
# MEMORY_ARBITER_CONFIG=~/.config/memory-arbiter/config.json
# update_check has intentionally no env toggle: set
# {"update_check":{"enabled":false}} in JSON to disable the one-shot PyPI check.

# Per-client identity.
MEMORY_ARBITER_CLIENT=codex
MEMORY_ARBITER_AGENT_ID=default
MEMORY_ARBITER_WORKSPACE=default

# Optional workspace isolation: none (default), weak, or strict. All three
# normalize workspace_canonical; none means no workspace ACL, not no governance.
# MEMORY_ARBITER_ISOLATION=none
# MEMORY_ARBITER_WORKSPACE_MATCH_DISTANCE=0.25
# MEMORY_ARBITER_WORKSPACE_QWEN_CANDIDATE_DISTANCE=0.25
# MEMORY_ARBITER_WORKSPACE_QWEN_CANDIDATE_TOP_K=3

# Weak-isolation continuous vector weighting. Off (default) keeps the binary
# nudge (same-ws +0.30 / cross-ws -0.15). On = precompute canonical cosine
# distances and weight on the 0.15→0.30 decay curve; default-pool, too-short
# names, and generic-only pairs keep the binary fallback.
# MEMORY_ARBITER_WORKSPACE_WEAK_VECTOR_WEIGHT=false
# Canonicals shorter than this never vector-admit (range 1–64; default 3).
# MEMORY_ARBITER_WORKSPACE_MIN_NAME_LEN=3

# Strict vector admission. Off (default) = exact same-canonical isolation. On =
# a strict caller also reads/governs guarded canonicals within the cosine cutoff
# (range 0.0–2.0; default 0.25). Missing vectors/sqlite-vec degrades to exact.
# MEMORY_ARBITER_WORKSPACE_RECALL_ADMISSION=false
# MEMORY_ARBITER_WORKSPACE_RECALL_CUTOFF=0.25

# Optional sqlite-vec evidence/workspace candidate recall.
# Core lexical recall runs without sqlite-vec and degrades automatically.
MEMORY_ARBITER_ENABLE_SQLITE_VEC=false
MEMORY_ARBITER_VEC_DIM=768

# Optional local GGUF embedding path. Prefer embedding.model_path in config.json.
# MEMORY_ARBITER_EMBEDDING_MODEL_PATH=/path/to/embedding-model.gguf
# Legacy fallback:
# MEMORY_ARBITER_GGUF=/path/to/embedding-model.gguf

# Optional local Qwen2.5-0.5B bidirectional four-field extraction for strict
# write-time notices and broad scan enhancement. Current backend is local_gguf
# only. Runtime auto-enables when a model path is set and enabled is omitted;
# the example JSON intentionally sets enabled=false, so editing only model_path
# there does NOT enable it—also change enabled to true (or remove that key).
# Install memory-arbiter-mcp[semantic-local] first; Python 3.13 may need to
# compile llama-cpp-python and therefore require C/C++ tools plus CMake.
# MEMORY_ARBITER_SEMANTIC_CONFLICT_ENABLED=true
# MEMORY_ARBITER_SEMANTIC_CONFLICT_MODEL_PATH=/path/to/qwen2.5-0.5b-instruct.gguf
# MEMORY_ARBITER_SEMANTIC_CONFLICT_BACKEND=local_gguf
# MEMORY_ARBITER_SEMANTIC_CONFLICT_MAX_NOTICE_PAIRS=2
# MEMORY_ARBITER_SEMANTIC_CONFLICT_ON_WRITE=async
# MEMORY_ARBITER_SEMANTIC_CONFLICT_QUEUE_MAX_SIZE=100
# MEMORY_ARBITER_SEMANTIC_CONFLICT_N_CTX=1024
# MEMORY_ARBITER_SEMANTIC_CONFLICT_N_THREADS=4
# MEMORY_ARBITER_SEMANTIC_CONFLICT_N_BATCH=128
# MEMORY_ARBITER_SEMANTIC_CONFLICT_RESIDENT=true
# MEMORY_ARBITER_SEMANTIC_CONFLICT_PRELOAD=false
# Job budget gates between pairs; a started inference has its own hard timeout.
# MEMORY_ARBITER_SEMANTIC_CONFLICT_JOB_TIMEOUT_MS=5000
# MEMORY_ARBITER_SEMANTIC_CONFLICT_INFERENCE_TIMEOUT_MS=30000
# MEMORY_ARBITER_SEMANTIC_CONFLICT_LOAD_TIMEOUT_MS=120000
# MEMORY_ARBITER_SEMANTIC_CONFLICT_MIN_PAIR_BUDGET_MS=1000
# MEMORY_ARBITER_SEMANTIC_CONFLICT_MAX_EVIDENCE_UNITS=24
# MEMORY_ARBITER_SEMANTIC_CONFLICT_SCAN_ENHANCE=true
# MEMORY_ARBITER_SEMANTIC_CONFLICT_SCAN_MAX_PAIRS=8
# MEMORY_ARBITER_SEMANTIC_CONFLICT_SCAN_BUDGET_MS=60000
# Delivery-only wait: 0 is fully async; timeout continues the same notice task.
# MEMORY_ARBITER_NOTICE_SYNC_WAIT_MS=3000
# Independent near-match workspace Qwen budget; timeout keeps raw canonical.
# MEMORY_ARBITER_WORKSPACE_QWEN_BUDGET_MS=750
